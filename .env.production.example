# Copy to .env.production and replace every placeholder.
# Never commit .env.production.

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
APP_DEFAULT_LOCALE=vi

MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
DB_NAME=lab_portal
DB_USERNAME=lab_portal_app
DB_PASSWORD=replace_with_a_long_random_app_password
REDIS_PASSWORD=replace_with_a_long_random_redis_password

JWT_SECRET=replace_with_base64_encoded_random_secret_at_least_32_bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Keep the username configured after first startup. Email/password are only
# needed to create the initial production administrator; clear them after login.
BOOTSTRAP_ADMIN_USERNAME=replace_with_a_new_admin_username
BOOTSTRAP_ADMIN_EMAIL=replace_with_a_real_admin_email
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_characters

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_account
MAIL_PASSWORD=replace_with_smtp_app_password
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

GOOGLE_CLIENT_ID=

AI_INTERNAL_SERVICE_TOKEN=replace_with_long_random_ai_internal_token
# Leave blank until the AWS AI service has a URL reachable from the backend container.
# With no AWS URL, AI requests fail with 503; other services can still start.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_ATTEMPT_TIMEOUT=240s

FACE_INTERNAL_SERVICE_TOKEN=replace_with_long_random_face_internal_token
FACE_CHALLENGE_SECRET=replace_with_long_random_face_challenge_secret
FACE_EMBEDDING_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
FACE_PROCESSOR_MODE=opencv
