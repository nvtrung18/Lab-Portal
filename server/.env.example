# Local backend runtime (copy to server/.env.properties; never commit that file)
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Database application user (never use the MySQL root account)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lab_portal
DB_USERNAME=lab_portal_app
DB_PASSWORD=replace_with_local_app_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_CONNECT_TIMEOUT=2s

# JWT
JWT_SECRET=replace_with_base64_encoded_secret_at_least_32_bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_local_smtp_username
MAIL_PASSWORD=replace_with_local_smtp_password
MAIL_FROM=noreply@example.invalid
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Browser origins trusted by CORS (comma-separated exact origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Local filesystem storage
CV_STORAGE_PATH=uploads/cv
REPORT_STORAGE_PATH=storage/reports
PRODUCT_STORAGE_PATH=storage/products

# Optional; no Java consumer currently requires this value
APP_FRONTEND_URL=http://localhost:5173
