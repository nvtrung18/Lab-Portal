# === Cấu hình cho Thư mục gốc (IDE & OS) ===
.idea/
*.iml
*.iws
*.ipr
.vscode/
.DS_Store
Thumbs.db
*.log


# === BACKEND (Thư mục server) ===
server/HELP.md
server/target/
server/.mvn/wrapper/maven-wrapper.jar
server/.apt_generated
server/.classpath
server/.factorypath
server/.project
server/.settings
server/.springBeans
server/.sts4-cache
# Giữ lại các file target quan trọng nếu có (theo quy tắc bạn gửi)
!server/**/src/main/**/target/
!server/**/src/test/**/target/


# === FRONTEND (Thư mục client) ===
client/node_modules/
client/.pnp
client/.pnp.js
client/coverage/
client/build/
client/dist/
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*

# === Cấu hình Build chung ===
bin/
build/
out/

# Local backend environment
server/.env.properties
