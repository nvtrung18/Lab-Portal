.gitignore
!.gitignore
*.md
!README.md
!docs/decisions/P2-DECISION-01.md
!docs/decisions/P2-DECISION-02.md
!docs/deployment/
!docs/deployment/**/*.md
*.docx
!docker-compose.yml
.codegraph
# Docker folder
!docker/
!docker/**

# Client folder
!client/
!client/**

# Server folder
!server/
!server/**


# IDE / OS
.idea/
*.iml
*.iws
*.ipr
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend build artifacts
server/target/
server/.mvn/wrapper/maven-wrapper.jar
server/.apt_generated
server/.classpath
server/.factorypath
server/.project
server/.settings/
server/.springBeans
server/.sts4-cache/
server/HELP.md
server/storage/
server/uploads/

# Environment files (examples and reviewed frontend mode files stay tracked)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!client/.env.development
!client/.env.production
server/.env.properties

# Frontend build artifacts & dependencies
client/node_modules/
client/dist/
client/build/
client/coverage/
client/.pnp
client/.pnp.js
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local

# Root level ignores
node_modules/
package-lock.json
bin/
build/
out/
qa/
