# Local Docker Compose only
APP_DEFAULT_LOCALE=vi
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
DB_NAME=lab_portal
DB_USERNAME=lab_portal_app
DB_PASSWORD=replace_with_local_app_password
REDIS_PORT=6379

# Optional backend-only Google Scholar sync (SerpApi). Never use a VITE_ prefix.
SCHOLAR_SYNC_ENABLED=false
SCHOLAR_SERPAPI_API_KEY=
SCHOLAR_SYNC_MAX_PAGES=100
SCHOLAR_SYNC_TIMEOUT_SECONDS=30
SCHOLAR_SYNC_MAX_SNAPSHOT_BYTES=8000000
